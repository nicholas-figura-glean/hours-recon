# Application: demo, mcp, or live (direct APIs)
HOURS_RECON_MODE=mcp
HOURS_RECON_MCP_SNAPSHOT_PATH=var/mcp_snapshot.json
HOURS_RECON_HOST=127.0.0.1
HOURS_RECON_PORT=8765
# Used by direct live mode. In MCP mode it is also the default snapshot binding.
HOURS_RECON_REQUESTER_EMAIL=your.name@example.com
# Required in MCP mode unless HOURS_RECON_REQUESTER_EMAIL is set. Must equal the
# authenticated Salesforce requester recorded in the MCP snapshot.
HOURS_RECON_MCP_REQUESTER_EMAIL=your.name@example.com
HOURS_RECON_TIMEZONE=America/Denver
HOURS_RECON_CACHE_MAX_AGE_DAYS=30

# Governance and local remediation planner. Observe-only preserves reported totals
# while separating governed/provisional exposure and opening ranked Tier 3/4
# workstreams. A schema-v1 remediation database is cleanly reset on first v2 startup.
HOURS_RECON_GOVERNANCE_MODE=observe_only
HOURS_RECON_REMEDIATION_MODE=observe_only
HOURS_RECON_REMEDIATION_DB_PATH=var/remediation.sqlite3
# Required for remediation validation transitions. Must exactly match the MCP
# snapshot's connector-verified meta.scope_id.
HOURS_RECON_REMEDIATION_SCOPE_ID=
# Browser record links and the destination opened after copying an MCP packet.
# Only HTTPS values are accepted; unsafe values fall back to these defaults.
HOURS_RECON_SALESFORCE_WEB_BASE_URL=https://glean.lightning.force.com
HOURS_RECON_ROCKETLANE_WEB_BASE_URL=https://glean.rocketlane.com
HOURS_RECON_MCP_WORKSPACE_URL=https://app.glean.com/chat

# Optional direct Slack delivery from remediation workspaces. Create a dedicated
# Slack app/bot with chat:write, im:write, users:read, and users:read.email.
# Add channels:read/groups:read for channel-name resolution. Keep this secret in
# .env only; it is never returned by the dashboard API.
HOURS_RECON_SLACK_BOT_TOKEN=

# The values below are only needed for HOURS_RECON_MODE=live.
# Salesforce: either provide a current access token + instance URL,
# or use an OAuth connected app refresh token.
SF_API_VERSION=62.0
SF_INSTANCE_URL=https://your-domain.my.salesforce.com
SF_ACCESS_TOKEN=
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=

# Optional override if automatic Account field discovery is ambiguous.
SF_AIOM_FIELD=
SF_AIOM_MATCH_VALUE=

# Rocketlane
ROCKETLANE_BASE_URL=https://api.rocketlane.com/api/1.0
ROCKETLANE_API_KEY=
